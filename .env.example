# Execute os comandos de desenvolvimento na raiz do monorepo.
BACKEND_ADDR=127.0.0.1:3000
DATABASE_URL=sqlite://data/discord.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ngrok: acrescente a origem HTTPS exata acima e o hostname em allowedHosts do Vite.
# Veja o README. Não autorize *.ngrok-free.dev nem reescreva o Origin no proxy.
RUST_LOG=info,tower_http=debug
COOKIE_SECURE=false
# Ao testar por ngrok/HTTPS, use COOKIE_SECURE=true e reinicie o backend.

# URLs ICE separadas por vírgula. STUN vazio desabilita servidores externos.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# Segredo privado do backend e do coturn (use-auth-secret). Nunca use VITE_*.
TURN_SHARED_SECRET=

# Variáveis VITE_* são públicas e incorporadas ao build do frontend.
# Vazio usa a mesma origem e o proxy /api do Vite.
VITE_API_BASE_URL=
